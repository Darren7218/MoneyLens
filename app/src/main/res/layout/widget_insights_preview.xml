<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="MoneyLens"
            android:textColor="#ECF2EC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill_soft_dark"
            android:text="On pace"
            android:textColor="#A8D5BA"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="7-day trend · Budgets · Ledger"
        android:textColor="#9BB09E"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="8dp">

        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="20" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="45" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="30" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="80" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="55" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginRight="4dp" android:max="100" android:progress="40" android:progressDrawable="@drawable/widget_bar_v" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:max="100" android:progress="65" android:progressDrawable="@drawable/widget_bar_v" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="58"
        android:progressDrawable="@drawable/widget_bar_h" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recent activity · Tap for ledger"
        android:textColor="#ECF2EC"
        android:textSize="11sp" />
</LinearLayout>
